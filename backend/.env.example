# PCS Universal Document Intelligence Configuration

# Application Server
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Storage Directory
STORAGE_DIR=../storage/uploads

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocr_db

# LLM Configuration (Google Gemini Free Tier recommended)
# Get your free key instantly from: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=

# OCR Binary Path (Optional override if not in system PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

